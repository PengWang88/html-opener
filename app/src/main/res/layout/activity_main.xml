<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page_apps"
            layout="@layout/page_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/page_links"
            layout="@layout/page_links"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/nav_apps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/nav_apps"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <View
                    android:id="@+id/indicator_apps"
                    android:layout_width="32dp"
                    android:layout_height="3dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@color/swiss_red" />

                <TextView
                    android:id="@+id/label_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:letterSpacing="0.08"
                    android:text="@string/nav_apps"
                    android:textColor="@color/ink"
                    android:textSize="11sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_links"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/nav_links"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <View
                    android:id="@+id/indicator_links"
                    android:layout_width="32dp"
                    android:layout_height="3dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@color/swiss_red"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/label_links"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:letterSpacing="0.08"
                    android:text="@string/nav_links"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
